#############################################
# OTTO LANDING PAGE - ENV CONFIGURATION
#############################################
# Copy to .env (gitignored). Do not put secrets here.
# Create React App only inlines REACT_APP_* ; craco copies APP_ENV and
# *_BASE_URL / *_MERCHANT_PORTAL_URL into REACT_APP_* so you can switch
# like admin and the mobile apps.
#
# Switch: set APP_ENV then restart `npm start` (port 3003).
# Values: local | test | staging | prod
# Production `npm run build` defaults to prod if APP_ENV / REACT_APP_ENV is unset.

APP_ENV=local

# Dedicated local port (do not share with backend :3000, merchant-portal :3001, admin :3002)
PORT=3003

# ===========================================
# API BASE URLS (hosts; /api is appended in src/config/env.js)
# ===========================================
LOCAL_BASE_URL=http://localhost:3000
TEST_BASE_URL=https://api-test.ottoafrica.com
STAGING_BASE_URL=https://staging-api.ottoafrica.com
PROD_BASE_URL=https://api.ottoafrica.com

# ===========================================
# MERCHANT PORTAL URLS
# ===========================================
LOCAL_MERCHANT_PORTAL_URL=http://localhost:3001
TEST_MERCHANT_PORTAL_URL=https://business-test.ottoafrica.com
STAGING_MERCHANT_PORTAL_URL=https://business-staging.ottoafrica.com
PROD_MERCHANT_PORTAL_URL=https://business.ottoafrica.com

# Optional CRA aliases (usually unnecessary — craco copies the names above)
# REACT_APP_ENV=local
# REACT_APP_LOCAL_BASE_URL=http://localhost:3000
# REACT_APP_TEST_BASE_URL=https://api-test.ottoafrica.com
# REACT_APP_STAGING_BASE_URL=https://staging-api.ottoafrica.com
# REACT_APP_PROD_BASE_URL=https://api.ottoafrica.com
# Legacy override (used only if the APP_ENV-selected URL is missing):
# REACT_APP_API_URL=http://localhost:3000/api
# REACT_APP_MERCHANT_PORTAL_URL=http://localhost:3001

REACT_APP_DEBUG=true
GENERATE_SOURCEMAP=false
